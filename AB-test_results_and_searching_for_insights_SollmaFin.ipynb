    "# Приведем дату и время события к date\n",
    "pa_sollmafin_abt['event_dt'] = pa_sollmafin_abt.event_ts.dt.date\n",
    "\n",
    "cum_adpu_list = []\n",
    "pval_records = []\n",
    "\n",
    "for dt in sorted(pa_sollmafin_abt.event_dt.unique()):\n",
    "    filtered_data = pa_sollmafin_abt[pa_sollmafin_abt['event_dt'] <= dt]\n",
    "    \n",
    "    # Посчитаем накопленную сумму депозитов на пользователей в группировке по группам\n",
    "    daily_amount = filtered_data.groupby(['group', 'user_id'])['amount'].sum().reset_index()\n",
    "    \n",
    "    # Распределим по группам накопленную сумму депозитов на пользователей\n",
    "    test_vals = daily_amount.query('group == \"test\"')['amount']\n",
    "    ctrl_vals = daily_amount.query('group == \"control\"')['amount'] \n",
    "\n",
    "    # Проведем т-тест для накопившихся данных к dt\n",
    "    if len(test_vals) >= 2 and len(ctrl_vals) >= 2:\n",
    "        stat, pval = ttest_ind(test_vals, ctrl_vals, equal_var=False)\n",
    "    else:\n",
    "        pval = None\n",
    "    \n",
    "    daily_cum_adpu = daily_amount.groupby('group')['amount'].mean().reset_index()\n",
    "    \n",
    "    daily_cum_adpu['date'] = dt\n",
    "    \n",
    "    cum_adpu_list.append(daily_cum_adpu)\n",
    "       \n",
    "        \n",
    "    pval_records.append({\n",
    "        'date': dt,\n",
    "        'p_value_ctrl_test': pval\n",
    "    })\n",
    "\n",
    "# Соберем датасет с накопительным adpu    \n",
    "cum_adpu = pd.concat(cum_adpu_list)\n",
    "    \n",
    "\n",
    "# Соберем датасет с накопительным p_value_ctrl_test по дням   \n",
    "pvalue_df = pd.DataFrame(pval_records)\n",
    "\n",
    "display(cum_adpu)\n",
    "display(pvalue_df)"
   ]
  },
