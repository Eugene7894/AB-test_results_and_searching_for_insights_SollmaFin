    "# Посчитаем ключевую, барьерную и вспомогательные метрики для контролбной и тестовой групп\n",
    "\n",
    "metrics = []\n",
    "\n",
    "for group in sorted(pa_sollmafin_abt.group.unique()):\n",
    "    \n",
    "    # Кол-во зарегистрированных пользователей\n",
    "    usr_reg = pa_sollmafin_abt.query(\"event_name == 'registration' and group == @group\")['user_id'].nunique()\n",
    "    # Кол-во пользователей с first_deposit\n",
    "    usr_first_dep = pa_sollmafin_abt.query(\"event_name == 'first_deposit' and group == @group\")['user_id'].nunique()\n",
    "    # Кол-во пользователей с second_deposit\n",
    "    usr_sec_dep = pa_sollmafin_abt.query(\"event_name == 'second_deposit' and group == @group\")['user_id'].nunique()\n",
    "       \n",
    "    metrics.append({\n",
    "        'group': group,\n",
    "        # Кол-во зарегистрированных пользователей\n",
    "        'usr_reg': usr_reg,\n",
    "        # Кол-во пользователей с первым депозитом\n",
    "        'usr_first_dep': usr_first_dep,\n",
    "        # Кол-во пользователей с вторым депозитом\n",
    "        'usr_sec_dep': usr_sec_dep,\n",
    "        # Посчитаем конверсию из регистрации в первый депозит\n",
    "        'cr_reg_first_dep': round(100 * usr_first_dep / usr_reg, 2),\n",
    "        # Посчитаем конверсию из первого депозита во второй\n",
    "        'cr_first_sec_dep': round(100 * usr_sec_dep / usr_first_dep, 2),\n",
    "        # Посчитаем среднюю сумму депозитов на пользователя - Average Deposit Per User (ADPU)\n",
    "        'adpu': pa_sollmafin_abt.query(\"group == @group\").groupby('user_id')['amount'].sum().mean().round(2),\n",
    "        # Посчитаем среднюю сумму депозитов на платящего пользователя - Average Deposit Per User (ADPPU)\n",
    "        'adppu': pa_sollmafin_abt.query(\"group == @group and amount > 0\").groupby('user_id')['amount'].sum().mean().round(2)\n",
    "    })\n",
