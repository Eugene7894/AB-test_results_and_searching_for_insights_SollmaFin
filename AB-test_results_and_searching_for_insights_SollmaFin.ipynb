    "# Проведем T-test Уэлча для ADPU и ADPPU\n",
    "\n",
    "# ADPU T-test Уэлча\n",
    "adpu_ctrl = pa_sollmafin_abt.query('group == \"control\"').groupby('user_id')['amount'].sum()\n",
    "adpu_test = pa_sollmafin_abt.query('group == \"test\"').groupby('user_id')['amount'].sum()\n",
