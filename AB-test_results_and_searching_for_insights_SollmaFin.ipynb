    "adppu_test = pa_sollmafin_abt.query('group == \"test\" and amount > 0').groupby('user_id')['amount'].sum()\n",
    "\n",
    "_, p_value_adppu = ttest_ind(adppu_ctrl, adppu_test, alternative='two-sided', equal_var=False)"
   ]
