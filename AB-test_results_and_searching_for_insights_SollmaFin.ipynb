    "# Получим данные с покупками первых активов пользователей\n",
    "first_asset_purch = pa_sollmafin_hist[pa_sollmafin_hist.event_name == 'asset_purchase'].groupby(['user_id', 'risk_level']).event_ts.min().reset_index()\n",
    "\n",
    "# Отберем пользователей с вторым депозитом\n",
    "usr_second_deposit = pa_sollmafin_hist[pa_sollmafin_hist.event_name == 'second_deposit']['user_id'].unique()\n",
    "\n",
    "# Добавим в датасет с покупками первых активов столбец, флагирующий пользователей с вторым депозитом\n",
    "first_asset_purch['have_second_deposit'] = first_asset_purch['user_id'].isin(usr_second_deposit)\n",
    "\n",
    "first_asset_purch"
   ]
