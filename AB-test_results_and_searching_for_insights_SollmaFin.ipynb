    "# Проведем z-тест пропорций для cr_reg_first_dep и cr_first_sec_dep\n",
    "\n",
    "# Конверсия регистрация -> 1 депозит\n",
    "n_reg_ctrl = df_metrics.loc['control', 'usr_reg']\n",
    "n_reg_test = df_metrics.loc['test', 'usr_reg']\n",
    "\n",
    "n_first_dep_ctrl = df_metrics.loc['control', 'usr_first_dep']\n",
    "n_first_dep_test = df_metrics.loc['test', 'usr_first_dep']\n",
    "\n",
    "_, p_value_reg_first_dep = proportions_ztest(count=[n_first_dep_test, n_first_dep_ctrl], \n",
    "                                             nobs=[n_reg_test, n_reg_ctrl], \n",
    "                                             alternative='two-sided')\n",
    "\n",
    "\n",
    "# Конверсия 1 депозит -> 2 депозит\n",
    "n_sec_dep_ctrl = df_metrics.loc['control', 'usr_sec_dep']\n",
    "n_sec_dep_test = df_metrics.loc['test', 'usr_sec_dep']\n",
    "\n",
    "_, p_value_first_sec_dep = proportions_ztest(count=[n_sec_dep_test, n_sec_dep_ctrl], \n",
    "                                             nobs=[n_first_dep_test, n_first_dep_ctrl], \n",
    "                                             alternative='two-sided')"
   ]
