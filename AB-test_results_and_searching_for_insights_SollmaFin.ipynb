   "source": [
    "# Построим классическую(classic_CR) и step-by-step(sbs_CR) воронки для контрольной группы\n",
    "funel_df_ctrl = pa_sollmafin_abt.query('group == \"control\"') \\\n",
    "    .groupby('event_name') \\\n",
    "    .agg(usr_cnt=('user_id', 'nunique')) \\\n",
    "    .reindex(funel_steps).reset_index()\n",
    "\n",
    "funel_df_ctrl['classic_CR'] = funel_df_ctrl.usr_cnt.div(funel_df_ctrl.usr_cnt[0]).round(3) * 100\n",
    "funel_df_ctrl['sbs_CR'] = funel_df_ctrl.usr_cnt.div(funel_df_ctrl.usr_cnt.shift(1)).round(3) * 100\n",
    "funel_df_ctrl"
   ]
  },
