   "source": [
    "# Сравним результаты между группами и посчитаем p_value с помощью z-test пропорций, \n",
    "# а стат значимость оценим скорректируя p_value поправкой Холма в следующем пункте.\n",
    "\n",
    "# Выделим уровни рисков бумаг для цикла\n",
    "risk_lvl = conversion_by_risk_abt.risk_level.unique()\n",
    "\n",
    "# Создадим список для накопления результатов z-test пропрций для бумаг с разными рисками\n",
    "stat_test_results = []\n",
    "\n",
    "for risk in risk_lvl:\n",
    "    ctrl_row = conversion_by_risk_abt.query('risk_level == @risk and group == \"control\"')\n",
    "    test_row = conversion_by_risk_abt.query('risk_level == @risk and group == \"test\"')   \n",
    "    \n",
    "    # Кол-во успехов(пользователи с 2 депозитом) и пользователей с покупкой актива\n",
    "    success = [\n",
    "        ctrl_row['usr_with_second_deposit'].values[0],\n",
    "        test_row['usr_with_second_deposit'].values[0]\n",
    "    ]\n",
    "    \n",
    "    total = [\n",
    "        ctrl_row['usr_with_purch'].values[0],\n",
    "        test_row['usr_with_purch'].values[0]\n",
    "    ]\n",
    "    \n",
    "    # z-тест пропорций\n",
    "    stat, p_value = proportions_ztest(count=success, nobs=total, alternative='two-sided')\n",
    "    \n",
    "    # Абсолютная и относительная разница в конверсии групп\n",
    "    diff_abs = test_row['cr_to_sec_dep'].values[0] - ctrl_row['cr_to_sec_dep'].values[0]\n",
    "    diff_rel = round(100 * diff_abs / ctrl_row['cr_to_sec_dep'].values[0], 2)\n",
    "    \n",
    "    stat_test_results.append(\n",
    "        {\n",
    "        'risk_lvl': risk,\n",
    "        'ctrl_cr_to_sec_dep': ctrl_row['cr_to_sec_dep'].values[0],\n",
    "        'test_cr_to_sec_dep': test_row['cr_to_sec_dep'].values[0],\n",
    "        'diff_abs_cr(pp)': diff_abs,\n",
    "        'diff_rel_cr(%)': diff_rel,\n",
    "        'p_value_risk_lvl': round(p_value, 5)               \n",
