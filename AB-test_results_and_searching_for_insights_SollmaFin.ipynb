   "source": [
    "# Получим данные с первыми покупками пользователей\n",
    "first_asset_purch_abt = pa_sollmafin_abt[pa_sollmafin_abt.event_name == 'asset_purchase'].groupby(['user_id', 'risk_level', 'group']).event_ts.min().reset_index()\n",
    "\n",
    "# Отберем пользователей с вторым депозитом\n",
    "usr_second_deposit = pa_sollmafin_abt[pa_sollmafin_abt.event_name == 'second_deposit']['user_id'].unique()\n",
    "\n",
    "# Добавим в датасет с покупками первых активов столбец, флагирующий пользователей с вторым депозитом\n",
    "first_asset_purch_abt['have_second_deposit'] = first_asset_purch_abt['user_id'].isin(usr_second_deposit)\n",
    "\n",
    "# Рассчитаем конверсию пользователей с купленным первым активом с разным уровнем риска в второй депозит для группы control\n",
    "conversion_by_risk_ctrl = first_asset_purch_abt.query('group == \"control\"').groupby('risk_level').agg(\n",
    "    usr_with_purch=('user_id', 'nunique'),\n",
    "    usr_with_second_deposit=('have_second_deposit', 'sum')).reset_index()\n",
    "conversion_by_risk_ctrl['cr_to_sec_dep'] = round(100 * \n",
    "                                            conversion_by_risk_ctrl.usr_with_second_deposit / \n",
    "                                            conversion_by_risk_ctrl.usr_with_purch, 2)\n",
    "conversion_by_risk_ctrl['group'] = \"control\"\n",
    "\n",
    "# Рассчитаем конверсию пользователей с купленным первым активом с разным уровнем риска в второй депозит для группы test\n",
    "conversion_by_risk_test = first_asset_purch_abt.query('group == \"test\"').groupby('risk_level').agg(\n",
    "    usr_with_purch=('user_id', 'nunique'),\n",
    "    usr_with_second_deposit=('have_second_deposit', 'sum')).reset_index()\n",
    "conversion_by_risk_test['cr_to_sec_dep'] = round(100 * \n",
    "                                            conversion_by_risk_test.usr_with_second_deposit / \n",
    "                                            conversion_by_risk_test.usr_with_purch, 2)\n",
    "conversion_by_risk_test['group'] = \"test\"\n",
    "\n",
    "# Склеим в один датасет данные для обеих групп эксперимента\n",
    "conversion_by_risk_abt = pd.concat([conversion_by_risk_ctrl, conversion_by_risk_test], ignore_index=True)\n",
    "conversion_by_risk_abt"
   ]
  },
