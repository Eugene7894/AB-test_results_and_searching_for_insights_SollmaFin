   "source": [
    "# Проверим наличие событий покупкки активов после внесения второго депозита\n",
    "df_abt = pa_sollmafin_abt.copy()\n",
    "\n",
    "# Получим время second_deposit для каждого пользователя (у которых оно было)\n",
    "second_deposit_time = df_abt[df_abt['event_name'] == 'second_deposit'][['user_id', 'event_ts']].set_index('user_id')\n",
    "second_deposit_time = second_deposit_time.rename(columns={'event_ts': 'second_deposit_ts'})\n",
    "\n",
    "# Присоединяем это время ко всем asset_purchase событиям\n",
    "asset_purchase = df_abt[df_abt['event_name'] == 'asset_purchase'].copy()\n",
    "asset_purchase = asset_purchase.join(second_deposit_time, on='user_id')\n",
    "\n",
    "# Фильтруем только asset_purchase события, которые были ПОСЛЕ second_deposit\n",
    "asset_after_second = asset_purchase[asset_purchase['event_ts'] > asset_purchase['second_deposit_ts']]\n",
    "asset_after_second"
   ]
