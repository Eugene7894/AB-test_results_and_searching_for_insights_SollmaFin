    "# Посчитаем абсолютные и относительные изменения значений в тестовой группе по сравнению с контрольной\n",
    "df_comparison = df_metrics.T.copy()\n",
    "\n",
    "df_comparison['abs_diff'] = df_comparison['test'] - df_comparison['control']\n",
    "df_comparison['rel_diff_%'] = round(100 * df_comparison['abs_diff'] / df_comparison['control'], 2)\n",
    "\n",
    "df_comparison = df_comparison.reset_index().rename(columns={'index': 'metrics'})\n",
    "\n",
    "# Уберем имя колонок group\n",
    "df_comparison.columns.name = None\n",
    "\n",
    "df_comparison"
