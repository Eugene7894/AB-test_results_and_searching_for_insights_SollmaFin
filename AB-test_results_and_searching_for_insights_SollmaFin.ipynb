    "# Фиксируем сид для воспроизводимости\n",
    "np.random.seed(341)\n",
    "\n",
    "# Сформируем выборки для бутстрапа  с платящими пользователями\n",
    "control = pa_sollmafin_abt.query('group == \"control\" and amount > 0').groupby('user_id')['amount'].sum()\n",
    "test = pa_sollmafin_abt.query('group == \"test\" and amount > 0').groupby('user_id')['amount'].sum()\n",
    "\n",
    "# Создадим функцию для расчета доверительного интервала для бутсрап анализа разных перцентилей\n",
    "def boot_diffs_ci_perc(control, test, perc, n_iterations=1000):\n",
    "    \n",
    "    boot_diffs = [] \n",
    "\n",
    "    for i in range(n_iterations):\n",
    "        # Формируем бутстрап выборки\n",
    "        boot_control = np.random.choice(control, size=len(control), replace=True)\n",
    "        boot_test = np.random.choice(test, size=len(test), replace=True)\n",
    "    \n",
    "        #Расчитаем perc перцентиль\n",
    "        ctrl_perc = np.percentile(boot_control, perc)\n",
    "        test_perc = np.percentile(boot_test, perc)\n",
    "        \n",
    "        # Добавляем разницу значений perc перцентиля тестовой и контрольной групп\n",
    "        boot_diffs.append(test_perc - ctrl_perc)\n",
    "    \n",
    "    boot_diffs = np.array(boot_diffs)\n",
    "    diff_ci = np.percentile(boot_diffs, [2.5, 97.5])\n",
    "        \n",
    "    return diff_ci, boot_diffs\n",
    "\n",
    "# Посчитаем разницу значений 25, 50 и 75 перцентилей тестовой и контрольной групп, а также 95% доверительный интервал \n",
    "for i in [25, 50, 75]:\n",
    "    diff_ci, boot_diffs = boot_diffs_ci_perc(control, test, i)\n",
    "\n",
    "    # Вывод 95% доверительного интервала\n",
    "    print(f\"{i}-й перцентиль контрольной группы: {np.percentile(control, i):.2f}\")\n",
    "    print(f\"{i}-й перцентиль тестовой группы: {np.percentile(test, i):.2f}\")\n",
    "    print(f\"95%-й доверительный интервал разности {i}-х перцентилей [{diff_ci[0]:.2f}, {diff_ci[1]:.2f}]\") \n",
    "    print('---------------------------------------------------')\n",
    "    \n",
    "    # Визуализация результатов бутстрапа разницы i-го перцентилей тестовой и контрольной групп, 95% доверительный интервал\n",
    "    plt.figure(figsize=(8, 6))\n",
    "    \n",
    "    sns.histplot(boot_diffs, bins=30, kde=True)\n",
    "    plt.axvline(diff_ci[0], color='red', linestyle='--', label='2.5-й перцентиль')\n",
    "    plt.axvline(diff_ci[1], color='red', linestyle='--', label='97.5-й перцентиль')\n",
    "    plt.axvline(np.percentile(test, i) - np.percentile(control, i), color='black', linestyle='-', label='Фактическая разница')\n",
    "    \n",
    "    plt.title(f'Бутстрап разницы {i}-х перцентилей (test - control)')\n",
    "    plt.xlabel('Разница {i}-х перцентилей')\n",
    "    plt.legend()\n",
    "    plt.grid()\n",
    "    \n",
    "    plt.tight_layout()\n",
    "    plt.show()"
   ]
  },
