   "source": [
    "# Построим классическую(classic_CR) и step-by-step(sbs_CR) воронки до оформления второго депозита для различных сегментов пользователей\n",
    "\n",
    "# Шаги воронки\n",
    "funel_steps = ['install / open_web', 'introduction', 'registration', 'main_page',\n",
    "       'onboarding_complete', 'first_deposit', 'asset_purchase', 'second_deposit']\n",
    "\n",
    "for country in pa_sollmafin_hist.country_code.unique():\n",
    "    for plfm in pa_sollmafin_hist.platform.unique():\n",
    "\n",
    "        funel_df = pa_sollmafin_hist.query('country_code == @country and platform == @plfm').groupby('event_name').agg(usr_cnt=('user_id', 'nunique')).reindex(funel_steps).reset_index()\n",
    "\n",
    "        # Классическая конверсия на разных этапах воронки\n",
    "        funel_df['classic_CR'] = funel_df.usr_cnt.div(funel_df.usr_cnt[0]).round(3) * 100\n",
    "\n",
    "        # Step-by-step конверсия на разных этапах воронки\n",
    "        funel_df['sbs_CR'] = funel_df.usr_cnt.div(funel_df.usr_cnt.shift(1)).round(3) * 100  \n",
    "        \n",
    "        # Построим диаграммы для обоих воронок для различных сегментов пользователей\n",
    "\n",
    "        fig, axes = plt.subplots(2, 1, figsize=(14, 8))\n",
    "\n",
    "        # Диаграмма Классическая воронка: конверсия по этапам\n",
    "        axes[0].bar(funel_df.event_name, funel_df.classic_CR)\n",
    "        axes[0].set_title(f'Классическая воронка {country} {plfm}: конверсия по этапам', fontsize=14, fontweight='bold')\n",
    "        axes[0].set_xlabel('Event_name', fontsize=12)\n",
    "        axes[0].set_ylabel('CR, %', fontsize=12)\n",
    "        axes[0].set_yticks(range(0, 101, 10))\n",
    "        axes[0].grid(axis='y', alpha=0.5)\n",
    "        axes[0].tick_params(axis='both', labelsize=11)\n",
    "\n",
    "        for x,y in zip(funel_df.event_name,funel_df.classic_CR):\n",
    "\n",
    "            label = \"{:.2f}%\".format(y)\n",
    "\n",
    "            axes[0].annotate(label,\n",
    "                         (x,y), \n",
    "                         textcoords=\"offset points\", \n",
    "                         color='white',    \n",
    "                         xytext=(0,-20),\n",
    "                         ha='center')\n",
    "\n",
    "        # Диаграмма Step-by-step воронка: конверсия от предыдущего этапа\n",
    "        axes[1].bar(funel_df.event_name, funel_df.sbs_CR)\n",
    "        axes[1].set_title(f'Step-by-step воронка: конверсия от предыдущего этапа {country} {plfm}', fontsize=14, fontweight='bold')\n",
    "        axes[1].set_xlabel('Event_name', fontsize=12)\n",
    "        axes[1].set_ylabel('CR, %', fontsize=12)\n",
    "        axes[1].set_ylim(top=100)\n",
    "        axes[1].set_yticks(range(0, 101, 10))\n",
    "        axes[1].grid(axis='y', alpha=0.5)\n",
    "        axes[1].tick_params(axis='both', labelsize=11)\n",
    "\n",
    "        for x,y in zip(funel_df.event_name, funel_df.sbs_CR):\n",
    "\n",
    "            label = \"{:.2f}%\".format(y)\n",
    "\n",
    "            axes[1].annotate(label,\n",
    "                         (x,y), \n",
    "                         textcoords=\"offset points\", \n",
    "                         color='white',    \n",
    "                         xytext=(0,-20),\n",
    "                         ha='center')\n",
    "\n",
    "        plt.tight_layout()\n",
    "        plt.show()"
   ]
  },
