   "source": [
    "# Определим статзначимость между метриками контрольной и тестовой групп в пунктах 3.3 и 3.4\n",
    "\n",
    "# Соберем датафрейм с метриками и соответствующими p_value\n",
    "df_holm = stat_test_prop_df[['risk_lvl', 'p_value_risk_lvl']].copy()\n",
    "\n",
    "df_holm['risk_lvl'] = df_holm['risk_lvl'] + '_' + df_holm['risk_lvl'].name + '_cr_to_sec_dep'\n",
    "df_holm.columns = ['metrics', 'p_value']\n",
    "\n",
    "# Добавим метрики и соответствующие p_value из п 3.4\n",
    "extra_pvals = pd.DataFrame({\n",
    "    'metrics': df_comparison.loc[3:, 'metrics'],\n",
    "    'p_value': [round(p_value_reg_first_dep, 5), \n",
    "                round(p_value_first_sec_dep, 5), \n",
    "                round(p_value_adpu, 5), \n",
    "                round(p_value_adppu, 5)], \n",
    "})\n",
    "\n",
    "# Объединим в один датафрейм метрики и их p_value\n",
    "df_holm = pd.concat([df_holm, extra_pvals], ignore_index=True)\n",
    "\n",
    "# Используем метод Холма для расчета скорректированных на множественные проверки гипотез p_value и сделаем добавим выводы \n",
    "# о статзначимости разницы метрик между группами\n",
    "conclusion, p_val_corr, _, _ = multipletests(df_holm['p_value'].values, alpha=0.05, method='holm')\n",
    "\n",
    "df_holm['p_val_corr'] = p_val_corr.round(5)\n",
    "df_holm['conclusion'] = ['Результат статзначим' if con else 'Результат не статзначим' for con in conclusion]\n",
    "df_holm"
   ]
  },
